# DIFFERITO — fuori perimetro della migrazione (ANNEX_A_FUORI_PERIMETRO.md A.3).
# Conservato come riferimento per quando esistera piu di un processo Node.
# Non introdurre Redis in produzione durante la migrazione.
# Redis volatile - NO SECRETS
REDIS_ENABLED=1
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=cassav6
REDIS_CACHE_ENABLED=1
REDIS_PRESENCE_ENABLED=1
REDIS_PUBSUB_ENABLED=1
REDIS_RATE_LIMIT_ENABLED=1
REDIS_CACHE_TTL_MS=5000
REDIS_PRESENCE_TTL_MS=30000
REDIS_CONNECT_TIMEOUT_MS=250
REDIS_COMMAND_TIMEOUT_MS=250
