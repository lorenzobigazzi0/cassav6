# PostgreSQL target - NO SECRETS
BACKEND_POSTGRES_ENABLED=0
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=cassav6
POSTGRES_USER=cassav6_app
POSTGRES_RUNTIME_ROLE=cassav6_runtime
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_SSL_MODE=disable
POSTGRES_POOL_MAX=6
POSTGRES_POOL_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECTION_TIMEOUT_MS=3000
POSTGRES_STATEMENT_TIMEOUT_MS=5000
POSTGRES_LOCK_TIMEOUT_MS=1000
POSTGRES_APPLICATION_NAME=cassav6-backend
