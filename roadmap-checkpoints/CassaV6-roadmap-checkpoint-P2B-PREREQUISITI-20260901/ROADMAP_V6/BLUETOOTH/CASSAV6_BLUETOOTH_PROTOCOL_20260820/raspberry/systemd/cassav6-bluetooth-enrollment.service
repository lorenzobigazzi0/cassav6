[Unit]
Description=CASSA V6 Bluetooth Enrollment Endpoint
After=network.target

[Service]
Type=simple
User=cassav6
UMask=0077
StateDirectory=cassav6-bluetooth
StateDirectoryMode=0700
WorkingDirectory=/opt/cassav6-bluetooth-node
Environment=CASSA_BT_ENROLLMENT_RUNTIME_ENABLED=0
Environment=CASSA_BT_PEER_TRUST_DIRECTORY_ENABLED=0
Environment=CASSA_BT_STATE_ROOT=/var/lib/cassav6-bluetooth
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/etc/cassav6/cassav6-bluetooth-enrollment.env
ExecStart=/usr/bin/env node /opt/cassav6-bluetooth-node/raspberry/scripts/enrollment-server.mjs
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/cassav6-bluetooth
ReadOnlyPaths=/etc/cassav6/bluetooth-enrollment.crt
ReadOnlyPaths=/etc/cassav6/bluetooth-enrollment.key
ReadOnlyPaths=-/etc/cassav6/bluetooth-peer-trust-authority.key
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
MemoryMax=128M
CPUQuota=50%
TasksMax=64
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
