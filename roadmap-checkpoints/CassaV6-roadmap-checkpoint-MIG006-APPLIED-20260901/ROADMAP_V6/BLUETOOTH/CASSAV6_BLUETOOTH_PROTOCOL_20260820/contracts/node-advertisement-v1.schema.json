{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NodeAdvertisementV1",
  "description": "Semantic representation of the fixed 10-byte discovery payload documented in architecture/DISCOVERY_PROTOCOL.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "nodeKind",
    "rotatingAlias",
    "bootId",
    "capabilities",
    "serverReachable",
    "sequence"
  ],
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "nodeKind": {
      "enum": [
        "raspberry",
        "handheld",
        "station"
      ]
    },
    "rotatingAlias": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{12}$"
    },
    "bootId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    },
    "capabilities": {
      "type": "integer",
      "minimum": 0,
      "maximum": 127,
      "description": "Capability bitmap v1; bit 7 is reserved and must be zero."
    },
    "serverReachable": {
      "type": "boolean"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    }
  }
}
