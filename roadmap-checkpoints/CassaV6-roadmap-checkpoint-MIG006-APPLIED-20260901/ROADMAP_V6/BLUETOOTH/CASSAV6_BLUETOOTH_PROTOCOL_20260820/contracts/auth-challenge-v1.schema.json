{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cassav6.local/contracts/auth-challenge-v1.schema.json",
  "title": "CASSA V6 mutual-auth challenge binding v1",
  "description": "Logical representation of the challenge already carried by the two HELLO messages. It is not an additional GATT frame.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "sessionId",
    "clientNodeId",
    "serverNodeId",
    "clientNonce",
    "serverNonce"
  ],
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{21}[AQgw]$"
    },
    "clientNodeId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "serverNodeId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "clientNonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{21}[AQgw]$"
    },
    "serverNonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{21}[AQgw]$"
    }
  }
}
