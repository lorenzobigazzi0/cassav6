# CASSAv4 STANDARD profile — comportamento più vicino possibile all'avvio corrente.
CASSAV4_RUNTIME_PROFILE=standard
CASSA_RUNTIME_PROFILE=standard
NODE_ENV=production
PORT=5280
PRINTING_ENABLED=1
RUNTIME_METRICS=1
DIAGNOSTICS_BASELINE=0
BACKEND_DB_MODE=mysql
BACKEND_RELATIONAL_ENABLED=1
BACKEND_RELATIONAL_MODE=shadow
BACKEND_MYSQL_SPLIT_APP_STATE_DOMAINS=1
BACKEND_MYSQL_SPLIT_SESSIONS=1
BACKEND_MYSQL_SPLIT_AUDIT_EVENTS=1
APP_STATE_DIRTY_TRACKING=0
EVENT_OUTBOX_ENABLED=0
COMMAND_INBOX_ENABLED=0
COMMAND_INBOX_MODE=off
SSE_EVENT_PAYLOAD=0
SCOPED_READS=0
PRINT_ASYNC_DISPATCH=0
PRINT_SPOOL_FAST_WORKER=0
CLIENT_PUSH_FIRST=0
CLIENT_WIDE_INVALIDATE_DISABLED=0
CLIENT_OPTIMISTIC_ACTIONS=0
REDIS_ENABLED=0
MQTT_ENABLED=0
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=cassav4
# MYSQL_USER=cassav4_user
# MYSQL_PASSWORD=change-me-outside-git
