# CASSAv4 NEAR_REALTIME + MQTT — MQTT solo per eventi realtime, non per verità transazionale.
CASSAV4_RUNTIME_PROFILE=near-realtime-mqtt
CASSA_RUNTIME_PROFILE=near-realtime-mqtt
MQTT_ENABLED=1
MQTT_EVENTS_ENABLED=1
MQTT_COMMANDS_ENABLED=0
# MQTT_COMMANDS richiede COMMAND_INBOX_ENABLED=1 prima del cutover.
# Step 15: anche con MQTT_COMMANDS_ENABLED=1 serve COMMAND_INBOX_MODE=write|enforce|enforce_pilot
# e MQTT_COMMAND_ACK_ENABLED=1. Default sicuro: ACK spento.
# Step 17 aggiunge solo il pilot notifications.ack, non il cutover runtime.
MQTT_COMMAND_ACK_ENABLED=0
MQTT_RETAINED_STATE_ENABLED=1
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_STORE_ID=default
# MQTT_USERNAME=cassav4-device
# MQTT_PASSWORD=change-me-outside-git
# TLS Step 14I: usare mqtts:// e path reali solo in file .env non committati.
# MQTT_TLS_ENABLED=1
# MQTT_URL=mqtts://192.168.0.28:8883
# MQTT_TLS_CA_PATH=/etc/mosquitto/certs/ca.crt
# MQTT_TLS_CERT_PATH=
# MQTT_TLS_KEY_PATH=
# MQTT_TLS_SERVERNAME=192.168.0.28
# MQTT_TLS_REJECT_UNAUTHORIZED=1
# Canary Mosquitto live Step 14G: usare valori reali solo in file .env non committati.
# MQTT_LIVE_CANARY_BROKER_URL=mqtt://192.168.0.28:1883
# MQTT_LIVE_BACKEND_USERNAME=backend
# MQTT_LIVE_BACKEND_PASSWORD=change-me-outside-git
# MQTT_LIVE_DEVICE_USERNAME=palmare-template
# MQTT_LIVE_DEVICE_PASSWORD=change-me-outside-git
# MQTT_LIVE_PRINTER_USERNAME=printer-gateway-template
# MQTT_LIVE_PRINTER_PASSWORD=change-me-outside-git
# Canary retained persistence Step 14H.
# MQTT_RETAINED_CANARY_BROKER_URL=mqtt://192.168.0.28:1883
# MQTT_RETAINED_BACKEND_USERNAME=backend
# MQTT_RETAINED_BACKEND_PASSWORD=change-me-outside-git
# MQTT_RETAINED_DEVICE_USERNAME=palmare-template
# MQTT_RETAINED_DEVICE_PASSWORD=change-me-outside-git
# MQTT_RETAINED_CANARY_STORE_ID=default
# MQTT_RETAINED_CANARY_MARKER_FILE=reports/mqtt-retained-persistence-marker.json
# Importa o copia anche configs/near-realtime.env.example.
