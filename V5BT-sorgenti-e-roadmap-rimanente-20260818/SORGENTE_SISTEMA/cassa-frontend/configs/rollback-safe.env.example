# CASSAv4 ROLLBACK_SAFE — profilo conservativo per tornare ai path legacy/stabili.
CASSAV4_RUNTIME_PROFILE=rollback-safe
CASSA_RUNTIME_PROFILE=rollback-safe
NODE_ENV=production
PORT=5280
PRINTING_ENABLED=1
RUNTIME_METRICS=1
DIAGNOSTICS_BASELINE=0
BACKEND_DB_MODE=mysql
BACKEND_RELATIONAL_ENABLED=1
BACKEND_RELATIONAL_MODE=shadow
BACKEND_MYSQL_SPLIT_APP_STATE_DOMAINS=1
APP_STATE_DIRTY_TRACKING=0
EVENT_OUTBOX_ENABLED=0
REALTIME_REPLAY_ENABLED=0
COMMAND_INBOX_ENABLED=0
COMMAND_INBOX_MODE=off
SSE_EVENT_PAYLOAD=0
SSE_LEGACY_REFRESH=1
SCOPED_READS=0
PRINT_ASYNC_DISPATCH=0
PRINT_SPOOL_FAST_WORKER=0
PRINT_SPOOL_SQL_PRIMARY=0
PRINT_CIRCUIT_BREAKER=0
CLIENT_PUSH_FIRST=0
CLIENT_WIDE_INVALIDATE_DISABLED=0
CLIENT_OPTIMISTIC_ACTIONS=0
REDIS_ENABLED=0
MQTT_ENABLED=0
BACKEND_REALTIME_GATEWAY_ENABLED=0
BACKEND_API_WORKER_ENABLED=0
BACKEND_MULTI_PROCESS_ORDER_WORKERS=0
BACKEND_POS_ROOM_CHANGE_APPROVE_ASYNC_PIN_PRELANE=0
