[Unit]
Description=CASSAv4 realtime gateway
Wants=network-online.target mariadb.service redis-server.service mosquitto.service cassav4-backend.service
After=network-online.target mariadb.service redis-server.service mosquitto.service cassav4-backend.service

[Service]
Type=simple
User=cassav4
Group=cassav4
WorkingDirectory=/opt/cassav4/current/cassa-frontend
EnvironmentFile=/etc/cassav4/cassav4.env
EnvironmentFile=-/etc/cassav4/cassav4-table-lock-worker.env
Environment=BACKEND_PROCESS_ROLE=realtime-gateway
Environment=BACKEND_HOST=127.0.0.1
Environment=BACKEND_PORT=5282
Environment=PORT=5282
Environment=PRINTING_ENABLED=0
ExecStart=/usr/local/bin/node backend/scripts/start-backend.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
CPUAffinity=0 1 2 3
LimitNOFILE=65535
MemoryMax=700M
StateDirectory=cassav4
LogsDirectory=cassav4
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
