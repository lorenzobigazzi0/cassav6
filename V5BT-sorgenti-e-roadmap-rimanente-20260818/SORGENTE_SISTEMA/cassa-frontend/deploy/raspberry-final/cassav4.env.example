# CASSAv4 final Raspberry target profile.
# Real secrets live only in /etc/cassav4/cassav4.env on the device.

CASSAV4_RUNTIME_PROFILE=raspberry-final
CASSA_RUNTIME_PROFILE=raspberry-final
NODE_ENV=production

# Required for browser clients on the LAN. Use the exact public HTTPS origin of
# the frontend; add further trusted origins as a comma-separated list.
CORS_ALLOWED_ORIGINS=https://192.168.1.79:5280

BACKEND_TOKEN_SECRET=change-me-32-plus-characters
SMART_CARD_READER_MODE=push
SMART_CARD_PUSH_TOKEN=change-me-32-plus-characters
SMART_CARD_AUTO_DETECT=0

BACKEND_DB_MODE=mysql
BACKEND_MYSQL_HOST=127.0.0.1
BACKEND_MYSQL_PORT=3306
BACKEND_MYSQL_DATABASE=cassav4
BACKEND_MYSQL_USER=cassav4_app
BACKEND_MYSQL_PASSWORD=change-me-outside-repo
BACKEND_MYSQL_CONNECTION_LIMIT=6
BACKEND_MYSQL_SPLIT_APP_STATE_DOMAINS=1
BACKEND_MYSQL_SPLIT_SESSIONS=1
BACKEND_MYSQL_TABLE_LOCKS=1
BACKEND_MYSQL_SPLIT_AUDIT_EVENTS=1
BACKEND_RELATIONAL_ENABLED=1
BACKEND_RELATIONAL_MODE=shadow
BACKEND_RELATIONAL_SHADOW_SYNC_ENABLED=0
BACKEND_RELATIONAL_DB_PATH=/var/lib/cassav4/backend-relational.sqlite
BACKEND_APP_STATE_SPLIT_DB_PATH=/var/lib/cassav4/app-state-split.sqlite
BACKEND_RELATIONAL_WAL_CHECKPOINT_OWNER=1
BACKEND_RELATIONAL_WAL_CHECKPOINT_INTERVAL_MS=1000

APP_STATE_DIRTY_TRACKING=write
APP_STATE_DIRTY_TRACKING_MODE=write
EVENT_OUTBOX_ENABLED=1
REALTIME_REPLAY_ENABLED=1
COMMAND_INBOX_ENABLED=1
COMMAND_INBOX_MODE=shadow
IDEMPOTENCY_STORE_ENABLED=1
SSE_EVENT_PAYLOAD=1
SSE_LEGACY_REFRESH=0
BACKEND_REALTIME_SCOPED_DELIVERY=1
BACKEND_REALTIME_HEARTBEAT_MS=5000
BACKEND_REALTIME_BOOTSTRAP_PADDING_BYTES=2048
SCOPED_READS=1

REDIS_ENABLED=1
REDIS_CACHE_ENABLED=1
REDIS_SESSIONS_ENABLED=1
REDIS_PRESENCE_ENABLED=1
REDIS_LOCKS_ENABLED=0
REDIS_PERSISTENT_CLIENT=0
REDIS_PERSISTENT_POOL_SIZE=4
BACKEND_TABLE_LOCK_WORKER_REDIS_SESSION_CACHE=0
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT_MS=1000
REDIS_COMMAND_TIMEOUT_MS=1000

MQTT_ENABLED=1
MQTT_EVENTS_ENABLED=1
MQTT_COMMANDS_ENABLED=0
MQTT_COMMAND_ACK_ENABLED=0
MQTT_RETAINED_STATE_ENABLED=1
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_STORE_ID=cassav4
MQTT_USERNAME=backend
MQTT_PASSWORD=change-me-outside-repo

PRINTING_ENABLED=1
PRINT_ASYNC_DISPATCH=1
PRINT_SPOOL_FAST_WORKER=1
PRINT_SPOOL_SQL_PRIMARY=1
PRINT_CIRCUIT_BREAKER=1
PRINT_SPOOL_CLAIM_LEASE_MS=30000
PRINT_CIRCUIT_BREAKER_THRESHOLD=3
PRINT_CIRCUIT_BREAKER_COOLDOWN_MS=10000
AUTO_PRINT_ENQUEUE_DELAY_MS=0

LANE_PAYMENTS=1
LANE_ROOMS=1
LANE_NOTIFICATIONS=1
ROOM_LANE_CONCURRENCY=1
RESERVATION_LANE_CONCURRENCY=4
LANE_PRINT=1
PRINT_LANE_ENABLED=1
LANE_STATION_STATE=1

BACKEND_REALTIME_GATEWAY_ENABLED=1
BACKEND_REALTIME_PORT=5282
BACKEND_API_WORKER_ENABLED=1
BACKEND_API_WORKER_COUNT=2
BACKEND_API_WORKER_PORTS=5283,5284
BACKEND_API_WORKER_ORIGIN=http://127.0.0.1:5283,http://127.0.0.1:5284
BACKEND_MULTI_PROCESS_TABLE_LOCK_WORKERS=1
BACKEND_MYSQL_TABLE_LOCK_NAMED_LOCKS=1
BACKEND_MYSQL_TABLE_LOCK_HYBRID=1
BACKEND_MYSQL_TABLE_LOCK_TOMBSTONES=0
BACKEND_TABLE_LOCK_WORKER_REQUEST_FASTPATH=1
BACKEND_TABLE_LOCK_WORKER_ORIGIN=http://127.0.0.1:5285
BACKEND_RUNTIME_METRICS_PEER_URLS=http://127.0.0.1:5282,http://127.0.0.1:5283,http://127.0.0.1:5284,http://127.0.0.1:5285
BACKEND_MULTI_PROCESS_READ_WORKERS=1
BACKEND_MULTI_PROCESS_READ_STATE_EXTERNALIZED=1
BACKEND_MULTI_PROCESS_ORDER_WORKERS=1
BACKEND_MULTI_PROCESS_ORDER_STATE_EXTERNALIZED=1
BACKEND_APP_STATE_SPLIT_TABLE_STATES=externalized
BACKEND_MULTI_PROCESS_ORDER_WORKFLOW_AUDIT_GO=1
BACKEND_MULTI_PROCESS_ORDER_WORKER_ROUTE_ALLOWLIST="POST /api/integration/orders/create,POST /api/integration/orders/sync,POST /api/integration/orders/cancel,POST /api/integration/orders/comp,POST /api/integration/orders/correct,POST /api/integration/orders/replacement/bar-charge,POST /api/orders/replacement/bar-charge,POST /api/integration/orders/line/split,POST /api/integration/orders/transfer/resolve,POST /api/integration/orders/transfer/request,POST /api/integration/orders/line/price-override,POST /api/integration/orders/transfer/force,POST /api/integration/orders/storno,POST /api/tables/lock/acquire,POST /api/tables/lock/heartbeat,POST /api/tables/lock/release,POST /api/tables/lock/force-release"

BACKEND_RELATIONAL_ORDERS_WRITE_PRIMARY=1
BACKEND_RELATIONAL_ORDERS_CREATE_WRITE_PRIMARY=1
BACKEND_RELATIONAL_ORDERS_SYNC_WRITE_PRIMARY=1
BACKEND_ORDERS_ASYNC_APPSTATE_FLUSH=1
BACKEND_RELATIONAL_TABLE_MOVE_WRITE_PRIMARY=1
BACKEND_RELATIONAL_TABLES_STARTUP_RECONCILE=1
BACKEND_RELATIONAL_AGGREGATE_LAST_EVENT_BINDING=1
BACKEND_RELATIONAL_ORDERS_READ_PRIMARY=1
BACKEND_RELATIONAL_LAYOUT_ORDERS_READ_PRIMARY=1
BACKEND_RELATIONAL_TABLES_READ_PRIMARY=1
BACKEND_RELATIONAL_LAYOUT_TABLES_READ_PRIMARY=1
BACKEND_RELATIONAL_PAYMENTS_REPORTS_READS=1
BACKEND_RELATIONAL_PAYMENTS_TICKET_WRITE_PRIMARY=1
BACKEND_RELATIONAL_PAYMENTS_TABLE_WRITE_PRIMARY=1
BACKEND_RELATIONAL_PAYMENTS_FREE_SPLIT_WRITE_PRIMARY=1
BACKEND_PAYMENT_FREE_SPLIT_DURABLE_MIRROR=0
BACKEND_PAYMENT_MIRROR_SKIP_POSSETTINGS_TABLES=0
BACKEND_PAYMENT_MIRROR_STATELESS_CONSUMER=0
BACKEND_PAYMENT_FREE_SPLIT_SETTINGS_REUSE=0
BACKEND_PAYMENT_MIRROR_WORKER_INTERVAL_MS=100
BACKEND_PAYMENT_MIRROR_WORKER_BATCH_SIZE=5
BACKEND_PAYMENT_MIRROR_WORKER_LEASE_MS=30000
BACKEND_PAYMENT_MIRROR_WORKER_RETRY_BASE_MS=250
BACKEND_PAYMENT_MIRROR_WORKER_RETRY_MAX_MS=30000
BACKEND_PAYMENT_MIRROR_WORKER_MAX_ATTEMPTS=100
BACKEND_PAYMENT_MIRROR_RETENTION_INTERVAL_MS=3600000
BACKEND_PAYMENT_MIRROR_COMPLETED_RETENTION_DAYS=30
BACKEND_PAYMENT_MIRROR_FAILED_RETENTION_DAYS=90
BACKEND_PAYMENT_MIRROR_CLEANUP_BATCH_SIZE=250
BACKEND_RELATIONAL_FISCAL_COMMAND_WRITE_PRIMARY=1
BACKEND_RELATIONAL_FISCAL_RECEIPTS_WRITE_PRIMARY=1
BACKEND_FISCAL_OUTBOX_ENABLED=1
BACKEND_FISCAL_OUTBOX_WORKER_ENABLED=1

FISCAL_PROVIDER=pos-fiscal-api
POS_FISCAL_API_BASE_URL=http://192.168.1.200:8765
POS_FISCAL_API_TIMEOUT_MS=20000
POS_FISCAL_API_JOB_RETRY_DELAY_MS=250
POS_FISCAL_API_RECOVERY_RETRY_DELAY_MS=30000

AUTOMATIC_CASH_GATEWAY_ENABLED=1
AUTOMATIC_CASH_GATEWAY_BASE_URL=http://192.168.1.200:9090
AUTOMATIC_CASH_GATEWAY_USERNAME=
AUTOMATIC_CASH_GATEWAY_PASSWORD=
AUTOMATIC_CASH_GATEWAY_TIMEOUT_MS=120000

BATTERY_SERVICE_URL=http://127.0.0.1:8765/battery
BATTERY_SERVICE_TIMEOUT_MS=1500
BATTERY_PROXY_CACHE_MS=1000
BATTERY_PROXY_EVENT_POLL_MS=1000

RUNTIME_METRICS=1
DIAGNOSTICS_BASELINE=1
DIAGNOSTICS_SAMPLE_RATE=1
DIAGNOSTICS_LOG_JSON=0
DIAGNOSTICS_LOG_PATH=/var/log/cassav4/performance-baseline.ndjson
DIAGNOSTICS_BASELINE_LOG_PATH=/var/log/cassav4/performance-baseline.ndjson

CLIENT_PUSH_FIRST=1
CLIENT_WIDE_INVALIDATE_DISABLED=0
CLIENT_OPTIMISTIC_ACTIONS=1
