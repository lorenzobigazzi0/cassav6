[Unit]
Description=CASSAv4 local fiscal simulator
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cassav4
Group=cassav4
WorkingDirectory=/opt/cassav4/current/cassa-frontend
Environment=MOCK_FISCAL_HOST=127.0.0.1
Environment=MOCK_FISCAL_PORT=9290
ExecStart=/usr/local/bin/node ../tools/mock-fiscal-server.mjs
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
CPUAffinity=0 1 2 3
MemoryMax=128M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
