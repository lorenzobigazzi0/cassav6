[Unit]
Description=CASSAv4 backend owner
Wants=network-online.target mariadb.service redis-server.service mosquitto.service
After=network-online.target mariadb.service redis-server.service mosquitto.service

[Service]
Type=simple
User=cassav4
Group=cassav4
WorkingDirectory=/opt/cassav4/current/cassa-frontend
EnvironmentFile=/etc/cassav4/cassav4.env
EnvironmentFile=-/etc/cassav4/cassav4-table-lock-worker.env
Environment=BACKEND_PROCESS_ROLE=api-owner
Environment=BACKEND_HOST=127.0.0.1
Environment=BACKEND_PORT=5281
Environment=PORT=5281
ExecStart=/usr/local/bin/node backend/scripts/start-backend.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
CPUAffinity=0 1 2 3
LimitNOFILE=65535
MemoryMax=2800M
StateDirectory=cassav4
LogsDirectory=cassav4
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
