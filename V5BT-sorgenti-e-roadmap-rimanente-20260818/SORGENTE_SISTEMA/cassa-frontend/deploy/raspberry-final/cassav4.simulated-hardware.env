# CASSAv4 local hardware simulators. This profile never contacts LAN hardware.
# Install and enable cassav4-fiscal-simulator.service and
# cassav4-automatic-cash-simulator.service before restarting the backend.

CASSAV4_TEST_DISABLE_REAL_IO=0
PRINTING_ENABLED=0

FISCAL_PROVIDER=pos-fiscal-api
FISCAL_REAL_IO_DISABLED=0
POS_FISCAL_REAL_IO_DISABLED=0
BACKEND_FISCAL_OUTBOX_ENABLED=1
BACKEND_FISCAL_OUTBOX_WORKER_ENABLED=1
POS_FISCAL_API_BASE_URL=http://127.0.0.1:9290
POS_FISCAL_API_TIMEOUT_MS=3000
POS_FISCAL_API_JOB_RETRY_DELAY_MS=500
POS_FISCAL_API_RECOVERY_RETRY_DELAY_MS=1000

AUTOMATIC_CASH_REAL_ENABLED=0
AUTOMATIC_CASH_GATEWAY_ENABLED=1
AUTOMATIC_CASH_GATEWAY_BASE_URL=http://127.0.0.1:9190
AUTOMATIC_CASH_GATEWAY_USERNAME=simulator
AUTOMATIC_CASH_GATEWAY_PASSWORD=simulator
AUTOMATIC_CASH_GATEWAY_TIMEOUT_MS=5000
AUTOMATIC_CASH_SIMULATOR_SEED=1
AUTOMATIC_CASH_SIMULATOR_CONFIG_PATH=/var/lib/cassav4/seed/fondo_cassa_100_combinazioni.json

CARD_PAYMENT_PROVIDER=mock
CARD_PAYMENT_MOCK_ENABLED=1
