# CASSAv4 Raspberry test-safe overrides.
# Apply these values in /etc/cassav4/cassav4.env while running tests that must
# not touch real automatic cash, real fiscal gateway or real TCP printers.

CASSAV4_TEST_DISABLE_REAL_IO=1
FISCAL_REAL_IO_DISABLED=1

PRINTING_ENABLED=0
BACKEND_FISCAL_OUTBOX_WORKER_ENABLED=0
POS_FISCAL_API_BASE_URL=http://127.0.0.1:9
POS_FISCAL_API_TIMEOUT_MS=1000
POS_FISCAL_API_JOB_RETRY_DELAY_MS=60000
POS_FISCAL_API_RECOVERY_RETRY_DELAY_MS=60000

AUTOMATIC_CASH_GATEWAY_ENABLED=0
AUTOMATIC_CASH_GATEWAY_BASE_URL=http://127.0.0.1:9
AUTOMATIC_CASH_GATEWAY_TIMEOUT_MS=1000
AUTOMATIC_CASH_SIMULATOR_SEED=1
AUTOMATIC_CASH_SIMULATOR_CONFIG_PATH=/var/lib/cassav4/seed/fondo_cassa_100_combinazioni.json

CARD_PAYMENT_PROVIDER=mock
CARD_PAYMENT_MOCK_ENABLED=1
