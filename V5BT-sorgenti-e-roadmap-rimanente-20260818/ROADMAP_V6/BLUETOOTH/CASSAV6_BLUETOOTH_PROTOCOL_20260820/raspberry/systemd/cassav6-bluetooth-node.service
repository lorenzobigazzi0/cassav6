[Unit]
Description=CASSA V6 Bluetooth Node
After=bluetooth.target network.target
Wants=bluetooth.target

[Service]
Type=simple
User=cassav6
UMask=0077
WorkingDirectory=/opt/cassav6-bluetooth-node/raspberry
Environment=CASSA_BT_FEATURE_ENABLED=0
Environment=CASSA_BT_GATT_SERVER_ENABLED=0
Environment=CASSA_BT_HELLO_ENABLED=0
Environment=CASSA_BT_MUTUAL_AUTH_ENABLED=0
Environment=CASSA_BT_DIRECT_CONTROL_ENABLED=0
Environment=CASSA_BT_RELIABLE_CHANNEL_ENABLED=0
Environment=CASSA_BT_ROUTE_ADVERTISEMENT_ENABLED=0
Environment=CASSA_BT_COMMAND_BUS_SHADOW_ENABLED=0
Environment=CASSA_BT_DEVICE_REGISTRY_PATH=/var/lib/cassav6-bluetooth/devices.json
Environment=CASSA_BT_TRANSPORT_STORE_PATH=/var/lib/cassav6-bluetooth/transport.sqlite
Environment=CASSA_BT_BACKEND_HEALTH_URL=http://127.0.0.1:5381/api/health
Environment=CASSA_BT_TRANSPORT_TICK_INTERVAL_MS=250
Environment=CASSA_BT_BACKEND_HEALTH_INTERVAL_MS=3000
Environment=CASSA_BT_HELLO_BOOT_ID=1
Environment=CASSA_BT_HELLO_CAPABILITIES=8
Environment=CASSA_BT_DRY_RUN=1
Environment=CASSA_BT_ADAPTER=hci0
Environment=CASSA_BT_NODE_ID=raspberry-main
Environment=CASSA_BT_STORE_ID=store-1
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/etc/cassav6/cassav6-bluetooth-node.env
ExecStart=/usr/bin/env node /opt/cassav6-bluetooth-node/raspberry/dist/index.js
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
StateDirectory=cassav6-bluetooth
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
MemoryMax=128M
CPUQuota=50%
TasksMax=64
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
